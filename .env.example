# 本機開發用設定範本。複製成 .env 後再改，.env 不進版控。
# Local 使用 .env.example；真實 Secret 由部署平台的安全 Secret store 注入。

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=kinsun
POSTGRES_USER=kinsun
POSTGRES_PASSWORD=kinsun_local_dev
POSTGRES_RUNTIME_PASSWORD=kinsun_runtime_local_development_only_2026
# 本機 5432 已被佔用時改這個值，例如 15432
POSTGRES_PORT=5432

# --- Application ---
# 一律使用 asyncpg 形式。Core API 直接用它；Alembic 會自行換成 psycopg，
# 因為 migration 走同步連線、應用層走非同步。
DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun
TEST_DATABASE_URL=postgresql+asyncpg://kinsun:kinsun_local_dev@localhost:5432/kinsun_test

# --- Supabase PostgreSQL alternative (Session Pooler / IPv4) ---
# 不使用 Supabase Auth 或 supabase-js；Core API 仍以 SQLAlchemy/asyncpg 直連 PostgreSQL。
# 在 Supabase Dashboard 的 Connect > Connection string 選 Session pooler（port 5432），
# 將密碼做 URL encoding 後，複製下列格式取代上方 DATABASE_URL：
# DATABASE_URL="postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=require"
# 單一低流量 VM 建議將下方 pool 調成 DB_POOL_SIZE=3、DB_MAX_OVERFLOW=2。
# TEST_DATABASE_URL 不得指向同一個 Supabase database；integration tests 會重建 schema。

# Local default uses QueuePool. ECS staging should override this to null for
# Aurora auto-pause and must not rely on DB_POOL_SIZE/DB_MAX_OVERFLOW in that mode.
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_RECOVERY_TIMEOUT_SECONDS=10

APP_ENV=development
# One-shot staging consent-policy bootstrap only. The command rejects
# APP_ENV=development/production and does not treat this as human approval.
CONSENT_POLICY_VERSION=demo-consent-v1
# 本機開發用的假認證。APP_ENV=production 時無效，且沒有設定真的
# authenticator 就會 fail closed（所有請求 401）。
FAKE_AUTH_ENABLED=true
# 只可使用 Synthetic seed 身分。三個值由 Core server 端解析，瀏覽器不能覆寫。
FAKE_AUTH_ACTOR_ID=20000000-0000-4000-8000-000000000001
FAKE_AUTH_TENANT_ID=10000000-0000-4000-8000-000000000001
FAKE_AUTH_ACTOR_ROLE=ELDER

# Generate a separate random value of at least 32 bytes per environment. It is
# blank here so a copied example fails closed until a real secret is injected.
FAMILY_INVITATION_HMAC_SECRET=

# --- Direct Google OIDC ---
# Create a Web application OAuth client in Google Cloud. The Client ID is used
# by both the BFF and Core verifier; the Client Secret belongs only in the BFF.
# Register the exact local redirect URI
# http://localhost:3000/backend/auth/google/callback in Google Cloud. The BFF
# route remains fail-closed until all three explicit gates below are enabled.
# Never commit a real secret or expose it through a NEXT_PUBLIC_* variable.
GOOGLE_DIRECT_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Dedicated 32+ byte HMAC secret; do not reuse any Provider secret.
GOOGLE_OIDC_TRANSACTION_SECRET=
# Core stores only a versioned keyed digest of Google subject identifiers.
# Keep this 32+ byte value independent from every OAuth and handoff secret.
GOOGLE_IDENTITY_HMAC_SECRET=
GOOGLE_IDENTITY_HMAC_KEY_VERSION=1
# Shared only by the Next.js BFF and Core internal handoff endpoint. Use a
# distinct 32+ byte value; never expose it through NEXT_PUBLIC_*.
GOOGLE_OIDC_HANDOFF_SECRET=
GOOGLE_OIDC_HANDOFF_ENABLED=false
GOOGLE_PENDING_IDENTITY_TTL_SECONDS=600
GOOGLE_OIDC_JWKS_CACHE_SECONDS=300
GOOGLE_OIDC_HTTP_TIMEOUT_SECONDS=5

# --- Kinsun-owned email authentication ---
# The synthetic adapter is development-only. Production must remain disabled
# until an approved email-delivery adapter is implemented.
KINSUN_NATIVE_AUTH_ENABLED=false
KINSUN_IDENTITY_HMAC_SECRET=
KINSUN_IDENTITY_HMAC_KEY_VERSION=1
KINSUN_EMAIL_CHALLENGE_HMAC_SECRET=
KINSUN_AUTH_HANDOFF_SECRET=
KINSUN_EMAIL_DELIVERY_MODE=disabled
KINSUN_SYNTHETIC_EMAIL_CODE_SECRET=
KINSUN_EMAIL_CHALLENGE_TTL_SECONDS=600
KINSUN_EMAIL_CHALLENGE_MAX_ATTEMPTS=5
KINSUN_PASSWORD_PARAMETER_VERSION=1
KINSUN_PASSWORD_MEMORY_COST_KIB=65536
KINSUN_PASSWORD_ITERATIONS=3
KINSUN_PASSWORD_LANES=4
KINSUN_PASSWORD_MAX_ATTEMPTS=5
KINSUN_PASSWORD_LOCKOUT_SECONDS=900
# Optional local-only shared QA password used by scripts/seed_demo.py.
# Minimum 12 characters. Never commit a real password.
DEMO_ACCOUNT_PASSWORD=
# Explicit opt-in for the non-destructive demo account provisioner when the
# configured development database is a Supabase project.
KINSUN_ALLOW_REMOTE_DEMO_ACCOUNT_PROVISIONING=false
# Separate explicit opt-in for inserting the complete synthetic Demo fixture
# into an existing Supabase development project. This never performs reset.
KINSUN_ALLOW_REMOTE_DEMO_SEED=false

# Core-owned App Session policy and explicit bearer-authentication gate.
APP_SESSION_AUTH_ENABLED=false
APP_SESSION_ELDER_FAMILY_IDLE_TTL_SECONDS=604800
APP_SESSION_ELDER_FAMILY_ABSOLUTE_TTL_SECONDS=2592000
APP_SESSION_WORKFORCE_IDLE_TTL_SECONDS=28800
APP_SESSION_WORKFORCE_ABSOLUTE_TTL_SECONDS=86400
APP_SESSION_TOUCH_INTERVAL_SECONDS=300
APP_SESSION_RECENT_AUTH_WINDOW_SECONDS=600
APP_SESSION_MAX_ACTIVE_PER_ACTOR=5

# --- LINE Messaging API + official Account Linking (disabled by default) ---
# All secrets must be distinct, server-side values of at least 32 bytes.
LINE_ACCOUNT_LINK_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_IDENTITY_HMAC_SECRET=
LINE_IDENTITY_HMAC_KEY_VERSION=1
LINE_ACCOUNT_LINK_BASE_URL=https://staging.example.com
LINE_LINK_CHALLENGE_TTL_SECONDS=600
LINE_LINK_CHALLENGE_MAX_ATTEMPTS=3
LINE_MESSAGING_TIMEOUT_SECONDS=10
LINE_SUBJECT_ENCRYPTION_SECRET=
LINE_DAILY_NOTIFICATION_ENABLED=false
LINE_DAILY_NOTIFICATION_TIMEZONE=Asia/Taipei
LINE_DAILY_NOTIFICATION_SEND_TIME=08:00

# Next.js BFF settings. Keep all of these server-only (no NEXT_PUBLIC prefix).
CORE_API_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Direct LINE Login + Core-owned identity linking ---
# This is distinct from LINE Messaging API / official Account Linking above.
# Keep disabled until the LINE Login channel, identity provider, callbacks and
# runtime permissions have been configured for the selected hosting platform.
# Direct LINE OIDC uses the same LINE Login channel credentials, but a separate
# callback, transaction secret, and BFF-to-Core handoff secret. Register the
# exact local callback http://localhost:3000/backend/auth/line/callback.
LINE_DIRECT_OIDC_ENABLED=false
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
# Runtime-only secret. Never reuse LINE_CHANNEL_SECRET or another transaction secret.
LINE_LOGIN_CHANNEL_SECRET=
LINE_OIDC_CALLBACK_URL=http://localhost:3000/backend/auth/line/callback
LINE_ACCOUNT_LINK_CALLBACK_URL=http://localhost:3000/backend/auth/identities/line/callback
LINE_OIDC_TRANSACTION_SECRET=
LINE_OIDC_HANDOFF_SECRET=
LINE_OIDC_HANDOFF_ENABLED=false
LINE_ACCOUNT_MERGE_TTL_SECONDS=600
LINE_PENDING_IDENTITY_TTL_SECONDS=600
LINE_OIDC_HTTP_TIMEOUT_SECONDS=5

# Gate 1 Voice Ticket 預設關閉；啟用時必須由 Secret Manager／安全的本機環境注入
# 各環境獨立的 32+ byte secret。Ticket 最長 120 秒，且不得進 URL 或 log。
VOICE_TICKET_ENABLED=false
VOICE_TICKET_HMAC_SECRET=
VOICE_TICKET_TTL_SECONDS=60
ASR_GATE_ENABLED=false
ASR_GATE_HMAC_SECRET=
ASR_GATE_CONFIDENCE_THRESHOLD=0.85
ASR_GATE_EVIDENCE_TTL_SECONDS=900

# Core 以 server-to-server 方式呼叫 Agent Runtime；瀏覽器不直接連線。
AGENT_RUNTIME_URL=http://127.0.0.1:8001
AGENT_RUNTIME_TIMEOUT_SECONDS=10
AGENT_RUNTIME_MODEL_ID=mock
# Gate 1 local/test service identity. Both Core and Runtime read the same
# dedicated secret; never reuse OAuth, Voice Ticket, provider, or database keys.
SERVICE_IDENTITY_ENABLED=false
SERVICE_IDENTITY_HMAC_SECRET=
SERVICE_IDENTITY_ISSUER=kinsun-local
SERVICE_IDENTITY_TTL_SECONDS=30

# Evidence-aware Memory rollout. Keep both false until the Core migration,
# negative tests, and synthetic E2E gate have passed in the target environment.
# AUTO_LOW_RISK_MEMORY may only be enabled with EVIDENCE_AWARE_MEMORY=true.
EVIDENCE_AWARE_MEMORY=false
AUTO_LOW_RISK_MEMORY=false

# --- Agent Runtime (services/agent-runtime) ---
# mock = 本地規則式回覆，不呼叫外部 LLM。
# gemini = Google Gen AI SDK；AQ. 開頭的 Vertex AI Express key 自動走 Vertex AI，其他 key 走
# Gemini Developer API。openai-compatible = provider-neutral Chat Completions HTTP adapter；
# bedrock = AWS Converse adapter。未完整設定時一律在啟動階段 fail closed。
MODEL_PROVIDER=mock
DEFAULT_LANGUAGE=zh-TW
LOG_LEVEL=INFO
# Agent 同步流程上限（AGENTS.md §7）。目前只有 MAX_AGENT_DECISIONS 真的被程式使用，
# 其餘三個已宣告但尚無 Tool 執行引擎，不代表已在管控。
MAX_AGENT_DECISIONS=3
MAX_TOOL_ROUNDS=2
MAX_TOTAL_TOOLS=5
MAX_REWRITE=1
# Release version persisted on Core-owned AgentRun rows for Tool-capable turns.
AGENT_VERSION=0.0.1
# --- Native Gemini text generation (optional) ---
# MODEL_PROVIDER=gemini 時必填。Key 只能放在未版控 .env 或部署平台 secret store。
GEMINI_API_KEY=
GEMINI_MODEL_ID=
GEMINI_MAX_TOKENS=512
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30
# --- Provider-neutral text generation (optional) ---
# MODEL_PROVIDER=openai-compatible 時必填 BASE_URL 與 MODEL_ID。API_KEY 對無驗證的本機端點可留空；
# 非 loopback HTTP 只要帶 API key 就會被拒絕，遠端服務必須使用 HTTPS。
# Google Gemini API 官方相容 base URL：
# https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_ID=
OPENAI_COMPATIBLE_MAX_TOKENS=512
OPENAI_COMPATIBLE_TEMPERATURE=0.2
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=30
# Tool-capable turns require a reachable Core API. Keep unset when only running
# local no-Tool conversations. The Runtime never stores a service token here;
# it forwards the caller's existing Authorization value for Core verification.
# CORE_API_BASE_URL=http://localhost:8001
CORE_API_TIMEOUT_SECONDS=5

# --- Staging RAG ---
# AWS credentials are intentionally not stored here. Local AWS authentication
# must come from the standard AWS credential provider chain.
AWS_REGION=
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBEDDING_DIMENSION=1024
OPENSEARCH_HOST=
OPENSEARCH_INDEX=ltc-public-knowledge-staging-v1
OPENSEARCH_ALIAS=ltc-public-knowledge-staging
RAG_ALLOWLIST_PATH=data/rag-manifest/AI_Reviewed_Embedding_Staging_Allowlist_v002.json
# Must come from an independently trusted deployment/configuration record before
# any Bedrock/OpenSearch operation; never derive it from the loaded Allowlist.
RAG_ALLOWLIST_EXPECTED_SHA256=
# Staging may use the narrowly scoped unsigned development override. Production
# always requires a signed/effective Allowlist regardless of this value.
RAG_REQUIRE_OWNER_SIGNATURE=false
# Hard kill switch for this staging-only release. Keep false; setting it true
# cannot enable a production target in the current ingestion service.
RAG_PRODUCTION_ENABLED=false
RAG_CHUNKS_DIR=data/rag-chunks/approved
RAG_MODE=staging
RAG_EMBEDDING_CONFIG_PATH=config/rag/embedding.yaml
RAG_OPENSEARCH_INDEX_CONFIG_PATH=config/rag/opensearch-index-v1.json
RAG_HYBRID_NATURAL_CONFIG_PATH=config/rag/hybrid-natural-language.json
RAG_HYBRID_LEGAL_CONFIG_PATH=config/rag/hybrid-legal.json
RAG_STAGING_FILTERS_CONFIG_PATH=config/rag/staging-filters.yaml
RAG_SMOKE_CONFIG_PATH=config/rag/smoke-test.yaml
# Server-to-server base URL used by the legacy TypeScript edge route and the
# ingestion E2E smoke test. The Python runtime owns retrieval and OpenSearch.
AGENT_RUNTIME_BASE_URL=http://localhost:8000
# Optional. If omitted, embedding artifacts are written below the OS temp
# directory. The ingestion service rejects paths inside this repository.
RAG_EMBEDDINGS_PATH=
# Optional. If omitted, the vector-free ingestion receipt is also written
# below the OS temp directory.
RAG_RECEIPT_PATH=

# --- Adminer (選用，docker compose --profile tools up -d) ---
ADMINER_PORT=8080

# --- Speech gateway (services/speech-gateway) ---
# Provider-routed ASR/TTS boundary for the voice path. Credentials are injected
# by the server deployment and are never exposed to browser code.
#
# Mandarin and English providers are selected by the server-owned routes below.
# Hokkien (nan-TW) and Hakka (hak-TW) recognition requires a self-hosted
# SageMaker endpoint; when SAGEMAKER_ASR_ENDPOINT is unset those languages are
# refused with 501 rather than falling through to a Mandarin model, which could
# return a fluent transcript of words the elder never said.
SAGEMAKER_ASR_ENDPOINT=
# Hokkien/Hakka synthesis requires a separately licensed and deployed private
# endpoint. Leave blank until its license and synthetic smoke-test gates pass;
# the gateway returns 501 instead of falling back to a Mandarin voice.
SAGEMAKER_TTS_ENDPOINT=
# Server-owned provider routes. These keys are registry entries, not vendor
# names accepted from a browser request. Unknown keys stop the service during
# startup; missing SageMaker endpoints fail closed on first use.
ASR_PROVIDER_ZH_TW=aws-transcribe
ASR_PROVIDER_EN_US=aws-transcribe
ASR_PROVIDER_NAN_TW=aws-sagemaker
ASR_PROVIDER_HAK_TW=aws-sagemaker
TTS_PROVIDER_ZH_TW=azure-speech-tts
TTS_PROVIDER_EN_US=azure-speech-tts
TTS_PROVIDER_NAN_TW=aws-sagemaker
TTS_PROVIDER_HAK_TW=aws-sagemaker
ASR_PROVIDER_TIMEOUT_SECONDS=30
TTS_PROVIDER_TIMEOUT_SECONDS=30
# Optional Deepgram Nova-3 ASR adapter for zh-TW and/or en-US. Leave the key
# blank unless a server-owned ASR route above selects deepgram-nova-3. The key
# belongs in the deployment secret store, never in this committed file or a
# NEXT_PUBLIC_* variable. Nova-3 is never a nan-TW or hak-TW route.
DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com
# Azure Speech TTS for zh-TW/en-US. Keep the key blank in committed files and
# inject it from the deployment secret store. Region examples include eastus.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TTS_VOICE_ZH_TW=zh-TW-HsiaoChenNeural
AZURE_SPEECH_TTS_VOICE_EN_US=en-US-JennyNeural
# Speech Gateway consumes Core-issued Voice Tickets and submits ASR Final over
# this server-to-server path. The token must resolve to a SYSTEM_SERVICE actor.
CORE_API_BASE_URL=http://127.0.0.1:8000
CORE_API_SERVICE_TOKEN=
CORE_API_TIMEOUT_SECONDS=5

# Browser audio is accepted only with a short-lived Voice Ticket. The gateway
# returns Core's trusted decision and never decides the confidence threshold.
NEXT_PUBLIC_SPEECH_GATEWAY_URL=http://127.0.0.1:8002

# Must equal the ACTIVE CONSENT version in eldercare_ai.policy_registry, created
# by app/consent_policy_bootstrap.py. A mismatch makes the consent panel refuse
# to grant rather than record consent against a policy version that does not exist.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=
