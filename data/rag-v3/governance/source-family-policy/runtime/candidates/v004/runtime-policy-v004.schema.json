            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Retrieval Audiences",
          "type": "array"
        },
        "source_allowed_purposes": {
          "items": {
            "enum": [
              "care_record",
              "care_summary",
              "evaluation",
              "explainable_evidence",
              "form_reference",
              "general_information",
              "health_education",
              "human_administered_assessment_design",
              "legal_reference",
              "manual_review",
              "research_reference",
              "resource_navigation",
              "safety_routing",
              "scale_explanation",
              "source_lookup"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Allowed Purposes",
          "type": "array"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
