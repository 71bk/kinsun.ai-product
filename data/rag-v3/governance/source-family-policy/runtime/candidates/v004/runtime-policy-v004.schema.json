        "published_at": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "review_status": {
          "const": "verified",
          "title": "Review Status",
          "type": "string"
        },
        "section": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "source_locator": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_page_updated_at": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Page Updated At"
        },
        "source_page_url": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Page Url"
        },
        "source_version": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Version"
        },
        "source_version_date": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Version Date"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version_published_at": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
