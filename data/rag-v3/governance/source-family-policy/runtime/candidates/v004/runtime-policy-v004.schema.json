        "requires_professional_assessment": {
          "title": "Requires Professional Assessment",
          "type": "boolean"
        },
        "retrieval_audiences": {
          "items": {
            "enum": [
              "elder",
              "family_caregiver",
              "care_professional",
              "system_admin"
