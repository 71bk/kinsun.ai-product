   "MinLength": 1
  },
  "CloudMapNamespace": {
   "Type": "String",
   "Default": "staging.kinsun.internal",
   "Description": "Existing foundation ECS Service Connect namespace.",
   "MinLength": 1
  },
  "DatabaseEndpoint": {
   "Type": "String",
