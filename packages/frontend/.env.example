# Next.js server-side proxy target. The browser only calls /backend/core/*.
CORE_API_INTERNAL_URL=http://127.0.0.1:8000

# Required in production for fail-closed Origin/CSRF validation. Keep this
# aligned with the exact public frontend origin (scheme + host + optional port).
FRONTEND_ORIGIN=http://localhost:3000

# Synthetic local policy created by scripts/seed_demo.py.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=demo-consent-v1

# Voice is a separate backend (packages/backend + infrastructure/, not the
# Core API this file otherwise configures). Leave unset to keep the home
# page on text companion; set both this AND a token via /dev-login to
# switch it to the voice panel. Value is the deployed WebSocketUrl CDK
# output, e.g. wss://xxxxx.execute-api.us-west-2.amazonaws.com/dev
NEXT_PUBLIC_WS_URL=
