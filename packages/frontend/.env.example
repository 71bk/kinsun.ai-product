# Next.js server-side proxy target. The browser only calls /backend/core/*.
CORE_API_INTERNAL_URL=http://127.0.0.1:8000

# Required in production for fail-closed Origin/CSRF validation. Keep this
# aligned with the exact public frontend origin (scheme + host + optional port).
FRONTEND_ORIGIN=http://localhost:3000

# Kinsun-owned Email + Password authentication. Email verification is used
# for registration; the browser submits credentials only to this BFF.
KINSUN_NATIVE_AUTH_ENABLED=false
KINSUN_AUTH_HANDOFF_SECRET=

# Direct Google OIDC. The callback URI is fixed from FRONTEND_ORIGIN as
# /backend/auth/google/callback. All secrets are server-only.
GOOGLE_DIRECT_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_TRANSACTION_SECRET=
# Must exactly match Core's server-only GOOGLE_OIDC_HANDOFF_SECRET.
GOOGLE_OIDC_HANDOFF_SECRET=

# Direct LINE Login v2.1. Register the exact callback URL in LINE Developers
# Console. All secrets are server-only and must be independent.
LINE_DIRECT_OIDC_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_OIDC_CALLBACK_URL=http://localhost:3000/backend/auth/line/callback
LINE_ACCOUNT_LINK_CALLBACK_URL=http://localhost:3000/backend/auth/identities/line/callback
LINE_OIDC_TRANSACTION_SECRET=
LINE_OIDC_HANDOFF_SECRET=

# Synthetic local policy created by scripts/seed_demo.py.
NEXT_PUBLIC_CONSENT_POLICY_VERSION=demo-consent-v1
