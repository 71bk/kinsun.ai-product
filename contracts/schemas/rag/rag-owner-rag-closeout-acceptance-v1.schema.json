{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/rag-owner-rag-closeout-acceptance-v1.schema.json",
  "title": "RagOwnerRagCloseoutAcceptanceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_version",
    "status",
    "project_owner_id",
    "signer_role",
    "signed_at",
    "authorization",
    "electronic_signature",
    "bindings",
    "purpose_verification",
    "conditional_stop_decision",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "acceptance_version": { "const": "v006" },
    "status": { "const": "SIGNED_STAGING_GOVERNANCE_DECISION" },
    "project_owner_id": { "const": "IanHsu" },
    "signer_role": { "const": "PROJECT_OWNER" },
    "signed_at": { "type": "string", "format": "date-time" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "statements", "statements_sha256"],
      "properties": {
        "channel": { "const": "interactive_user_instruction" },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "statements_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "electronic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance", "signature_value", "intent", "cryptographic_signature"],
      "properties": {
        "assurance": { "const": "RECORDED_EXPLICIT_USER_AUTHORIZATION" },
        "signature_value": { "const": "IanHsu" },
        "intent": { "const": "VERIFY_PURPOSE_AND_AUTHORIZE_CONDITIONAL_STOP_REVIEW" },
        "cryptographic_signature": { "type": "null" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_purpose_acceptance_path",
        "prior_purpose_acceptance_sha256",
        "prior_runtime_policy_path",
        "prior_runtime_policy_sha256",
        "source_policy_path",
        "source_policy_sha256",
        "candidate_path",
        "candidate_checksums_sha256"
      ],
      "properties": {
        "prior_purpose_acceptance_path": {
          "const": "data/rag-v3/review/acceptance/v005/owner-purpose-classification-acceptance.json"
        },
        "prior_purpose_acceptance_sha256": { "$ref": "#/$defs/Sha256" },
        "prior_runtime_policy_path": {
          "const": "data/rag-v3/governance/source-family-policy/runtime/candidates/v003/source-family-runtime-policy.json"
        },
        "prior_runtime_policy_sha256": { "$ref": "#/$defs/Sha256" },
        "source_policy_path": {
          "const": "data/rag-v3/governance/source-family-policy/candidates/v002/source-family-policy-map.json"
        },
        "source_policy_sha256": { "$ref": "#/$defs/Sha256" },
        "candidate_path": { "const": "data/rag-v3/candidates/v003" },
        "candidate_checksums_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "purpose_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "affected_chunk_count",
        "human_verified_classification_count",
        "needs_review_classification_count",
        "candidate_chunk_bytes_mutated",
        "decisions"
      ],
      "properties": {
        "method": { "const": "OWNER_VERIFIED_PRIOR_AI_ASSISTED_CLASSIFICATION" },
        "affected_chunk_count": { "const": 32 },
        "human_verified_classification_count": { "const": 32 },
        "needs_review_classification_count": { "const": 0 },
        "candidate_chunk_bytes_mutated": { "const": false },
        "decisions": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/PurposeDecision" }
        }
      }
    },
    "conditional_stop_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_chunk_count",
        "owner_disposition",
        "runtime_activation",
        "stop_normal_rag_preserved",
        "runtime_policy_candidate_count",
        "audience_review_pending_count",
        "decisions"
      ],
      "properties": {
        "affected_chunk_count": { "const": 27 },
        "owner_disposition": { "const": "CONDITIONALLY_RELEASABLE_AFTER_AUDIENCE_REVIEW" },
        "runtime_activation": { "const": "DENIED_PENDING_AUDIENCE_REVIEW" },
        "stop_normal_rag_preserved": { "const": true },
        "runtime_policy_candidate_count": { "const": 0 },
        "audience_review_pending_count": { "const": 27 },
        "decisions": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "items": { "$ref": "#/$defs/ConditionalStopDecision" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "external_sync", "runtime_policy_change", "production_status", "production_approved"],
      "properties": {
        "environment": { "const": "STAGING" },
        "external_sync": { "const": "NOT_AUTHORIZED" },
        "runtime_policy_change": { "const": "NOT_AUTHORIZED_BY_THIS_ACCEPTANCE" },
        "production_status": { "const": "BLOCKED" },
        "production_approved": { "const": false }
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Purpose": {
      "enum": [
        "care_record",
        "care_summary",
        "general_information",
        "health_education",
        "manual_review",
        "resource_navigation",
        "source_lookup"
      ]
    },
    "PurposeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_chunk_id",
        "chunk_id",
        "source_id",
        "text_sha256",
        "allowed_purposes",
        "rationale_code",
        "decision_review_status"
      ],
      "properties": {
        "prior_chunk_id": { "$ref": "#/$defs/Identifier" },
        "chunk_id": { "$ref": "#/$defs/Identifier" },
        "source_id": { "const": "mohw_a_unit_case_manager_manual_20230719" },
        "text_sha256": { "$ref": "#/$defs/Sha256" },
        "allowed_purposes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": { "const": "general_information" },
          "items": { "$ref": "#/$defs/Purpose" }
        },
        "rationale_code": {
          "enum": [
            "BACKGROUND_AND_SOURCE_CONTEXT",
            "POLICY_OR_TRAINING_MANUAL",
            "CASE_MANAGEMENT_WORKFLOW",
            "RESOURCE_REFERRAL_OR_ASSIGNMENT",
            "FOLLOWUP_QUALITY_OR_COORDINATION"
          ]
        },
        "decision_review_status": { "const": "verified" }
      }
    },
    "ConditionalStopDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_chunk_id",
        "chunk_id",
        "source_id",
        "text_sha256",
        "effective_risk_level",
        "observed_allowed_audiences",
        "observed_allowed_purposes",
        "owner_disposition",
        "audience_review_status",
        "runtime_retrieval_active",
        "stop_normal_rag_preserved",
        "required_next_gate"
      ],
      "properties": {
        "prior_chunk_id": { "$ref": "#/$defs/Identifier" },
        "chunk_id": { "$ref": "#/$defs/Identifier" },
        "source_id": { "const": "hpa_dementia_health_education_resource_manual_201610" },
        "text_sha256": { "$ref": "#/$defs/Sha256" },
        "effective_risk_level": { "enum": ["low", "medium"] },
        "observed_allowed_audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["family_caregiver", "care_professional"] }
        },
        "observed_allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Purpose" }
        },
        "owner_disposition": { "const": "CONDITIONALLY_RELEASABLE_AFTER_AUDIENCE_REVIEW" },
        "audience_review_status": { "const": "needs_review" },
        "runtime_retrieval_active": { "const": false },
        "stop_normal_rag_preserved": { "const": true },
        "required_next_gate": { "const": "PER_CHUNK_AUDIENCE_AND_PURPOSE_VERIFICATION" }
      }
    }
  }
}
