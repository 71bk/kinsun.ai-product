{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/human-review-owner-risk-acceptance-v1.schema.json",
  "title": "RagHumanReviewOwnerRiskAcceptanceV1",
  "description": "A project-owner electronic risk acceptance for internal human review. It never asserts source verification, completed review, or Production approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_version",
    "assignment_package_version",
    "candidate_artifact_version",
    "status",
    "project_owner_id",
    "signer_role",
    "signed_at",
    "authorization",
    "electronic_signature",
    "accepted_artifacts",
    "acceptance_scope",
    "risk_acknowledgements",
    "verification_assertions",
    "human_source_review",
    "review_status",
    "embedding_status",
    "indexing_status",
    "production_status",
    "production_approved",
    "external_access_performed"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "acceptance_version": { "const": "v001" },
    "assignment_package_version": { "const": "v001" },
    "candidate_artifact_version": { "const": "v002" },
    "status": { "const": "SIGNED" },
    "project_owner_id": { "$ref": "#/$defs/Identifier" },
    "signer_role": { "const": "PROJECT_OWNER" },
    "signed_at": { "type": "string", "format": "date-time" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "statement", "statement_sha256"],
      "properties": {
        "channel": { "const": "interactive_user_instruction" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "statement_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "electronic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "signature_value",
        "intent",
        "cryptographic_signature"
      ],
      "properties": {
        "assurance": { "const": "RECORDED_EXPLICIT_USER_AUTHORIZATION" },
        "signature_value": { "$ref": "#/$defs/Identifier" },
        "intent": { "const": "ACCEPT_INTERNAL_HUMAN_REVIEW_RISK" },
        "cryptographic_signature": { "type": "null" }
      }
    },
    "accepted_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "checksums_path",
        "checksums_sha256",
        "package_inventory_sha256"
      ],
      "properties": {
        "manifest_path": { "const": "data/rag-v2/human-review/v001/manifest.json" },
        "manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "checksums_path": { "const": "data/rag-v2/human-review/v001/SHA256SUMS.txt" },
        "checksums_sha256": { "$ref": "#/$defs/Sha256" },
        "package_inventory_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "acceptance_scope": { "const": "INTERNAL_HUMAN_REVIEW_ONLY" },
    "risk_acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepts_unreviewed_source_risk",
        "accepts_missing_local_source_files",
        "pending_source_assignments",
        "pending_chunk_assignments",
        "external_access_not_performed"
      ],
      "properties": {
        "accepts_unreviewed_source_risk": { "const": true },
        "accepts_missing_local_source_files": { "const": true },
        "pending_source_assignments": { "const": 17 },
        "pending_chunk_assignments": { "const": 726 },
        "external_access_not_performed": { "const": true }
      }
    },
    "verification_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fidelity_verified",
        "exact_facts_verified",
        "source_version_verified",
        "license_verified"
      ],
      "properties": {
        "source_fidelity_verified": { "const": false },
        "exact_facts_verified": { "const": false },
        "source_version_verified": { "const": false },
        "license_verified": { "const": false }
      }
    },
    "human_source_review": { "const": "NOT_COMPLETED" },
    "review_status": { "const": "needs_review" },
    "embedding_status": { "const": "NOT_STARTED" },
    "indexing_status": { "const": "NOT_STARTED" },
    "production_status": { "const": "BLOCKED" },
    "production_approved": { "const": false },
    "external_access_performed": { "const": false }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
