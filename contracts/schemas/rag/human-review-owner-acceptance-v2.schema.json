{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/human-review-owner-acceptance-v2.schema.json",
  "title": "RagHumanReviewOwnerAcceptanceV2",
  "description": "A project-owner authorization bound to the fixed-hash candidate v002 allowlist. It permits staging document embedding only and never grants indexing or Production approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_version",
    "supersedes_acceptance_version",
    "assignment_package_version",
    "candidate_artifact_version",
    "status",
    "project_owner_id",
    "signer_role",
    "signed_at",
    "authorization",
    "electronic_signature",
    "accepted_artifacts",
    "acceptance_scope",
    "review_assertions",
    "embedding_authorization",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "acceptance_version": { "const": "v002" },
    "supersedes_acceptance_version": { "const": "v001" },
    "assignment_package_version": { "const": "v001" },
    "candidate_artifact_version": { "const": "v002" },
    "status": { "const": "SIGNED" },
    "project_owner_id": { "$ref": "#/$defs/Identifier" },
    "signer_role": { "const": "PROJECT_OWNER" },
    "signed_at": { "type": "string", "format": "date-time" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "statement", "statement_sha256"],
      "properties": {
        "channel": { "const": "interactive_user_instruction" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "statement_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "electronic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance", "signature_value", "intent", "cryptographic_signature"],
      "properties": {
        "assurance": { "const": "RECORDED_EXPLICIT_USER_AUTHORIZATION" },
        "signature_value": { "$ref": "#/$defs/Identifier" },
        "intent": { "const": "AUTHORIZE_FIXED_HASH_STAGING_DOCUMENT_EMBEDDING" },
        "cryptographic_signature": { "type": "null" }
      }
    },
    "accepted_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_acceptance_manifest_path",
        "prior_acceptance_manifest_sha256",
        "allowlist_path",
        "allowlist_sha256",
        "allowlist_size_bytes",
        "chunk_manifest_path",
        "chunk_manifest_sha256",
        "candidate_checksums_path",
        "candidate_checksums_sha256",
        "source_count",
        "chunk_count"
      ],
      "properties": {
        "prior_acceptance_manifest_path": {
          "const": "data/rag-v2/human-review/acceptance/v001/manifest.json"
        },
        "prior_acceptance_manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "allowlist_path": {
          "const": "data/rag-v2/candidates/v002/manifests/embedding-staging-allowlist-v003.json"
        },
        "allowlist_sha256": { "$ref": "#/$defs/Sha256" },
        "allowlist_size_bytes": { "type": "integer", "minimum": 1 },
        "chunk_manifest_path": {
          "const": "data/rag-v2/candidates/v002/manifests/chunk-file-manifest-v002.json"
        },
        "chunk_manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "candidate_checksums_path": {
          "const": "data/rag-v2/candidates/v002/SHA256SUMS.txt"
        },
        "candidate_checksums_sha256": { "$ref": "#/$defs/Sha256" },
        "source_count": { "const": 17 },
        "chunk_count": { "const": 726 }
      }
    },
    "acceptance_scope": { "const": "STAGING_DOCUMENT_EMBEDDING_ONLY" },
    "review_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_review_and_signature_statement_recorded",
        "formal_item_level_review_evidence",
        "assignment_package_status",
        "source_assignment_count",
        "chunk_assignment_count",
        "review_status"
      ],
      "properties": {
        "owner_review_and_signature_statement_recorded": { "const": true },
        "formal_item_level_review_evidence": { "const": "NOT_RECORDED" },
        "assignment_package_status": { "const": "PENDING_ONLY" },
        "source_assignment_count": { "const": 17 },
        "chunk_assignment_count": { "const": 726 },
        "review_status": { "const": "needs_review" }
      }
    },
    "embedding_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "allowed_use",
        "required_document_input_type",
        "required_dimension",
        "provider_profile_binding_required",
        "mixed_embedding_profiles_allowed",
        "allowed_actions"
      ],
      "properties": {
        "environment": { "const": "STAGING" },
        "allowed_use": { "const": "INTERNAL_EMERGENCY_DEMO_ONLY" },
        "required_document_input_type": { "const": "RETRIEVAL_DOCUMENT" },
        "required_dimension": { "const": 1024 },
        "provider_profile_binding_required": { "const": true },
        "mixed_embedding_profiles_allowed": { "const": false },
        "allowed_actions": {
          "const": [
            "HAND_OFF_FIXED_HASH_ALLOWLIST_TO_STAGING_EMBEDDING_JOB",
            "GENERATE_DOCUMENT_EMBEDDINGS",
            "WRITE_STAGING_EMBEDDINGS",
            "VERIFY_STAGING_EMBEDDINGS"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding_status",
        "indexing_status",
        "production_status",
        "production_approved",
        "external_access_performed"
      ],
      "properties": {
        "embedding_status": { "const": "AUTHORIZED_NOT_STARTED" },
        "indexing_status": { "const": "NOT_AUTHORIZED" },
        "production_status": { "const": "BLOCKED" },
        "production_approved": { "const": false },
        "external_access_performed": { "const": false }
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
