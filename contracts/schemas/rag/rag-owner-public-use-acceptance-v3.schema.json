{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/rag-owner-public-use-acceptance-v3.schema.json",
  "title": "RagOwnerPublicUseAcceptanceV3",
  "description": "Project-owner approval to build and test v003 public retrieval policy in staging. It does not grant Production approval or assert item-level source fidelity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_version",
    "candidate_artifact_version",
    "status",
    "project_owner_id",
    "signer_role",
    "signed_at",
    "authorization",
    "electronic_signature",
    "accepted_artifacts",
    "acceptance_scope",
    "public_use_decision",
    "retrieval_policy_decision",
    "review_assertions",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "acceptance_version": {
      "const": "v001"
    },
    "candidate_artifact_version": {
      "const": "v003"
    },
    "status": {
      "const": "SIGNED"
    },
    "project_owner_id": {
      "$ref": "#/$defs/Identifier"
    },
    "signer_role": {
      "const": "PROJECT_OWNER"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "statements",
        "statements_sha256"
      ],
      "properties": {
        "channel": {
          "const": "interactive_user_instruction"
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "statements_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "electronic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "signature_value",
        "intent",
        "cryptographic_signature"
      ],
      "properties": {
        "assurance": {
          "const": "RECORDED_EXPLICIT_USER_AUTHORIZATION"
        },
        "signature_value": {
          "$ref": "#/$defs/Identifier"
        },
        "intent": {
          "const": "AUTHORIZE_V003_STAGING_PUBLIC_RETRIEVAL_POLICY"
        },
        "cryptographic_signature": {
          "type": "null"
        }
      }
    },
    "accepted_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_candidate_path",
        "prior_candidate_checksums_sha256",
        "prior_allowlist_sha256",
        "prior_acceptance_path",
        "prior_acceptance_sha256",
        "source_count",
        "chunk_count",
        "official_source_count",
        "official_chunk_count",
        "research_source_count",
        "research_chunk_count"
      ],
      "properties": {
        "prior_candidate_path": {
          "const": "data/rag-v2/candidates/v002"
        },
        "prior_candidate_checksums_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prior_allowlist_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prior_acceptance_path": {
          "const": "data/rag-v2/human-review/acceptance/v002/owner-staging-embedding-acceptance.json"
        },
        "prior_acceptance_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_count": {
          "const": 17
        },
        "chunk_count": {
          "const": 726
        },
        "official_source_count": {
          "const": 14
        },
        "official_chunk_count": {
          "const": 651
        },
        "research_source_count": {
          "const": 3
        },
        "research_chunk_count": {
          "const": 75
        }
      }
    },
    "acceptance_scope": {
      "const": "STAGING_PUBLIC_RETRIEVAL_POLICY"
    },
    "public_use_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_source_review_completed",
        "project_use_approved",
        "owner_approval_replaces_source_evidence"
      ],
      "properties": {
        "public_source_review_completed": {
          "const": true
        },
        "project_use_approved": {
          "const": true
        },
        "owner_approval_replaces_source_evidence": {
          "const": false
        }
      }
    },
    "retrieval_policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_audiences",
        "high_or_unknown_normal_rag",
        "audience_override_bypasses_risk",
        "embedding_reuse_allowed"
      ],
      "properties": {
        "allowed_audiences": {
          "const": [
            "elder",
            "family_caregiver",
            "care_professional",
            "system_admin"
          ]
        },
        "high_or_unknown_normal_rag": {
          "const": "DENY"
        },
        "audience_override_bypasses_risk": {
          "const": false
        },
        "embedding_reuse_allowed": {
          "const": true
        }
      }
    },
    "review_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_item_level_source_fidelity",
        "exact_facts_verified",
        "source_version_verified",
        "review_status"
      ],
      "properties": {
        "formal_item_level_source_fidelity": {
          "const": "NOT_RECORDED"
        },
        "exact_facts_verified": {
          "const": "NOT_RECORDED"
        },
        "source_version_verified": {
          "const": "PRESERVE_EXISTING_EVIDENCE"
        },
        "review_status": {
          "const": "needs_review"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "candidate_build",
        "external_sync",
        "production_status",
        "production_approved"
      ],
      "properties": {
        "environment": {
          "const": "STAGING"
        },
        "candidate_build": {
          "const": "AUTHORIZED"
        },
        "external_sync": {
          "const": "NOT_AUTHORIZED"
        },
        "production_status": {
          "const": "BLOCKED"
        },
        "production_approved": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
