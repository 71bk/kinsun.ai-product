{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/human-review-chunk-assignment-v1.schema.json",
  "title": "RagHumanReviewChunkAssignmentV1",
  "description": "Immutable chunk-level human-review assignment for the RagChunkV2 v002 candidate. Human decision fields remain pending in this assignment package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "candidate_artifact_version",
    "assignment_id",
    "source_assignment_id",
    "batch_id",
    "source_number",
    "source_id",
    "successor_chunk_id",
    "prior_chunk_id",
    "chunk_index",
    "candidate_chunk_path",
    "candidate_line_number",
    "review_track",
    "review_scope",
    "priority",
    "citation",
    "content_evidence",
    "governance_snapshot",
    "retrieval_snapshot",
    "mapping_warnings",
    "human_decision",
    "production_approved"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "package_version": { "const": "v001" },
    "candidate_artifact_version": { "const": "v002" },
    "assignment_id": { "$ref": "#/$defs/Identifier" },
    "source_assignment_id": { "$ref": "#/$defs/Identifier" },
    "batch_id": { "$ref": "#/$defs/Identifier" },
    "source_number": { "type": "integer", "minimum": 1 },
    "source_id": { "$ref": "#/$defs/Identifier" },
    "successor_chunk_id": { "$ref": "#/$defs/Identifier" },
    "prior_chunk_id": { "$ref": "#/$defs/Identifier" },
    "chunk_index": { "type": "integer", "minimum": 1 },
    "candidate_chunk_path": {
      "type": "string",
      "pattern": "^data/rag-v2/candidates/v002/chunks/[^/]+\\.jsonl$"
    },
    "candidate_line_number": { "type": "integer", "minimum": 1 },
    "review_track": { "enum": ["official_source", "research_evidence"] },
    "review_scope": { "enum": ["flagged", "baseline"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "section",
        "source_locator",
        "physical_page_start",
        "physical_page_end",
        "printed_page_start",
        "printed_page_end",
        "direct_source_url",
        "source_page_url",
        "license_evidence_url",
        "storage_url"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "section": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source_locator": { "type": ["string", "null"], "maxLength": 2048 },
        "physical_page_start": { "$ref": "#/$defs/NullablePositiveInteger" },
        "physical_page_end": { "$ref": "#/$defs/NullablePositiveInteger" },
        "printed_page_start": { "$ref": "#/$defs/NullablePositiveInteger" },
        "printed_page_end": { "$ref": "#/$defs/NullablePositiveInteger" },
        "direct_source_url": { "$ref": "#/$defs/NullableUri" },
        "source_page_url": { "$ref": "#/$defs/NullableUri" },
        "license_evidence_url": { "$ref": "#/$defs/NullableUri" },
        "storage_url": { "$ref": "#/$defs/NullableUri" }
      }
    },
    "content_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_sha256", "embedding_text_sha256", "char_count"],
      "properties": {
        "text_sha256": { "$ref": "#/$defs/Sha256" },
        "embedding_text_sha256": { "$ref": "#/$defs/Sha256" },
        "char_count": { "type": "integer", "minimum": 1 }
      }
    },
    "governance_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "current_status",
        "version_check_status",
        "license_status",
        "human_source_review"
      ],
      "properties": {
        "review_status": { "const": "needs_review" },
        "current_status": { "enum": ["current", "superseded", "unknown"] },
        "version_check_status": { "enum": ["pending", "verified_official_source"] },
        "license_status": { "enum": ["approved", "open", "permission_required", "unknown"] },
        "human_source_review": { "const": "not_completed" }
      }
    },
    "retrieval_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "requires_official_assessment",
        "requires_professional_assessment",
        "requires_human_review",
        "stop_normal_rag",
        "retrieval_eligible",
        "retrieval_block_reasons"
      ],
      "properties": {
        "risk_level": { "enum": ["low", "medium", "high", "high_red_line", null] },
        "requires_official_assessment": { "type": ["boolean", "null"] },
        "requires_professional_assessment": { "type": ["boolean", "null"] },
        "requires_human_review": { "type": "boolean" },
        "stop_normal_rag": { "type": ["boolean", "null"] },
        "retrieval_eligible": { "type": "boolean" },
        "retrieval_block_reasons": { "$ref": "#/$defs/UniqueStrings" }
      }
    },
    "mapping_warnings": { "$ref": "#/$defs/UniqueStrings" },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "source_fidelity_status",
        "exact_fact_status",
        "risk_status",
        "assessment_status",
        "reviewer_id",
        "reviewed_at",
        "evidence_references",
        "correction_notes",
        "recommended_review_status"
      ],
      "properties": {
        "decision_status": { "const": "pending" },
        "source_fidelity_status": { "const": "not_reviewed" },
        "exact_fact_status": { "const": "not_reviewed" },
        "risk_status": { "const": "not_reviewed" },
        "assessment_status": { "const": "not_reviewed" },
        "reviewer_id": { "type": "null" },
        "reviewed_at": { "type": "null" },
        "evidence_references": { "type": "array", "maxItems": 0 },
        "correction_notes": { "type": "null" },
        "recommended_review_status": { "const": "needs_review" }
      }
    },
    "production_approved": { "const": false }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "NullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "NullableUri": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "UniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 160 },
      "uniqueItems": true
    }
  }
}
