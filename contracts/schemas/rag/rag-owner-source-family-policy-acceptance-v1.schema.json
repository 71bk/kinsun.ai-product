{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/rag/rag-owner-source-family-policy-acceptance-v1.schema.json",
  "title": "RagOwnerSourceFamilyPolicyAcceptanceV1",
  "description": "Recorded project-owner authorization for source-family policy v002, including public-use evidence handling and five explicit general-risk classifications. This is staging-only and never approves Production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_version",
    "candidate_artifact_version",
    "policy_map_version",
    "status",
    "project_owner_id",
    "signer_role",
    "signed_at",
    "authorization",
    "electronic_signature",
    "bindings",
    "license_policy_decision",
    "risk_policy_decision",
    "retrieval_architecture_decision",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "acceptance_version": { "const": "v003" },
    "candidate_artifact_version": { "const": "v003" },
    "policy_map_version": { "const": "v002" },
    "status": { "const": "SIGNED" },
    "project_owner_id": { "$ref": "#/$defs/Identifier" },
    "signer_role": { "const": "PROJECT_OWNER" },
    "signed_at": { "type": "string", "format": "date-time" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "statements", "statements_sha256"],
      "properties": {
        "channel": { "const": "interactive_user_instruction" },
        "statements": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "statements_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "electronic_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance", "signature_value", "intent", "cryptographic_signature"],
      "properties": {
        "assurance": { "const": "RECORDED_EXPLICIT_USER_AUTHORIZATION" },
        "signature_value": { "$ref": "#/$defs/Identifier" },
        "intent": { "const": "AUTHORIZE_SOURCE_FAMILY_POLICY_V002" },
        "cryptographic_signature": { "type": "null" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_path",
        "candidate_checksums_sha256",
        "candidate_audit_lock_path",
        "candidate_audit_lock_sha256",
        "prior_acceptance_path",
        "prior_acceptance_sha256",
        "prior_policy_path",
        "prior_policy_sha256",
        "source_count",
        "chunk_count"
      ],
      "properties": {
        "candidate_path": { "const": "data/rag-v3/candidates/v003" },
        "candidate_checksums_sha256": { "$ref": "#/$defs/Sha256" },
        "candidate_audit_lock_path": {
          "const": "data/rag-v3/audits/v001/preflight/candidate-artifact-lock.json"
        },
        "candidate_audit_lock_sha256": { "$ref": "#/$defs/Sha256" },
        "prior_acceptance_path": {
          "const": "data/rag-v3/review/acceptance/v002/owner-human-review-acceptance.json"
        },
        "prior_acceptance_sha256": { "$ref": "#/$defs/Sha256" },
        "prior_policy_path": {
          "const": "data/rag-v3/governance/source-family-policy/candidates/v001/source-family-policy-map.json"
        },
        "prior_policy_sha256": { "$ref": "#/$defs/Sha256" },
        "source_count": { "const": 17 },
        "chunk_count": { "const": 726 }
      }
    },
    "license_policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_party_public_use_review_completed",
        "missing_license_url_automatic_block",
        "affected_source_count",
        "affected_source_ids",
        "license_status_mutation_authorized",
        "scope"
      ],
      "properties": {
        "source_party_public_use_review_completed": { "const": true },
        "missing_license_url_automatic_block": { "const": false },
        "affected_source_count": { "const": 13 },
        "affected_source_ids": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "license_status_mutation_authorized": { "const": false },
        "scope": { "const": "STAGING_PROJECT_USE_POLICY" }
      }
    },
    "risk_policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_label",
        "canonical_risk_level",
        "mapping_basis",
        "affected_chunk_count",
        "affected_chunk_ids",
        "chunk_bytes_mutated",
        "formal_assessment_performed"
      ],
      "properties": {
        "owner_label": { "const": "一般風險值" },
        "canonical_risk_level": { "const": "low" },
        "mapping_basis": { "const": "OWNER_GENERAL_RISK_CLASSIFICATION_TO_CANONICAL_LOW" },
        "affected_chunk_count": { "const": 5 },
        "affected_chunk_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "chunk_bytes_mutated": { "const": false },
        "formal_assessment_performed": { "const": false }
      }
    },
    "retrieval_architecture_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_public_retrieval_audiences",
        "retrieve_before_response_policy",
        "response_policy_required",
        "high_or_unknown_ordinary_rag",
        "stop_normal_rag_true_ordinary_rag",
        "runtime_safety_from_embedding_similarity"
      ],
      "properties": {
        "ordinary_public_retrieval_audiences": {
          "const": ["elder", "family_caregiver", "care_professional", "system_admin"]
        },
        "retrieve_before_response_policy": { "const": true },
        "response_policy_required": { "const": true },
        "high_or_unknown_ordinary_rag": { "const": "DENY" },
        "stop_normal_rag_true_ordinary_rag": { "const": "DENY" },
        "runtime_safety_from_embedding_similarity": { "const": false }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "policy_candidate_build",
        "external_sync",
        "supabase_release",
        "production_status",
        "production_approved"
      ],
      "properties": {
        "environment": { "const": "STAGING" },
        "policy_candidate_build": { "const": "AUTHORIZED" },
        "external_sync": { "const": "NOT_AUTHORIZED" },
        "supabase_release": { "const": "NOT_CREATED" },
        "production_status": { "const": "BLOCKED" },
        "production_approved": { "const": false }
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
