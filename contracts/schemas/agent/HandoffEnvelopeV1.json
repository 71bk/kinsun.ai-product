{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/agent/HandoffEnvelopeV1.json",
  "title": "HandoffEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "workflow_instance_id",
    "session_id",
    "actor_id",
    "actor_role",
    "elder_id",
    "tenant_id",
    "purpose",
    "consent_version",
    "policy_version",
    "language",
    "risk_level",
    "context_manifest",
    "context_budget",
    "allowed_tools",
    "max_steps",
    "latency_budget_ms",
    "parent_agent",
    "handoff_reason",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workflow_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor_role": {
      "type": "string",
      "enum": ["elder", "family", "staff", "system"]
    },
    "elder_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "purpose": {
      "type": "string",
      "maxLength": 256
    },
    "consent_version": {
      "type": "string",
      "maxLength": 64
    },
    "policy_version": {
      "type": "string",
      "maxLength": 64
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2})?$"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "context_manifest": {
      "$ref": "https://kinsun.ai/contracts/schemas/agent/ContextManifestV1.json"
    },
    "context_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,40}$"
      }
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "latency_budget_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "parent_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "handoff_reason": {
      "type": "string",
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
