{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/agent/MemoryCandidateProposalV1.json",
  "title": "MemoryCandidateProposalV1",
  "description": "Minimized, untrusted proposal only. Scope, source event IDs, consent, confirmation, and persistence remain Core-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_type",
    "memory_kind",
    "normalized_content",
    "confirmation_question",
    "extraction_confidence",
    "proposal_risk_hint",
    "extractor_version"
  ],
  "properties": {
    "memory_type": {
      "type": "string",
      "enum": [
        "PREFERENCE",
        "IMPORTANT_RELATIONSHIP",
        "ROUTINE",
        "COMMUNICATION_PREFERENCE",
        "PERSONAL_HISTORY"
      ]
    },
    "memory_kind": {
      "type": "string",
      "enum": [
        "MUSIC_PREFERENCE",
        "HOBBY",
        "PREFERRED_ADDRESS",
        "FAMILY_RELATIONSHIP",
        "CONTACT_ROUTINE",
        "DAILY_ROUTINE",
        "HEALTH_INFERENCE",
        "MEDICATION_JUDGMENT",
        "MOOD_OR_LONELINESS_INFERENCE",
        "FAMILY_CONFLICT",
        "FINANCIAL_INFORMATION",
        "SENSITIVE_OR_UNKNOWN"
      ]
    },
    "normalized_content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confirmation_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "proposal_risk_hint": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Untrusted Agent hint for observability only; Core derives the actual risk."
    },
    "extractor_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
