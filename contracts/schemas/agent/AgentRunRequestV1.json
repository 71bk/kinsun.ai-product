{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/agent/AgentRunRequestV1.json",
  "title": "AgentRunRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "session_id",
    "actor_id",
    "actor_role",
    "elder_id",
    "tenant_id",
    "purpose",
    "consent_version",
    "policy_version",
    "language",
    "input_text",
    "allowed_tools",
    "max_steps",
    "latency_budget_ms"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trace_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "agent_run_id": {
      "description": "Optional Core-owned run identifier. The canonical Core path supplies it before invoking Runtime; direct compatibility callers may omit it.",
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "actor_role": {
      "type": "string",
      "enum": ["elder", "family", "staff", "system"]
    },
    "elder_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "purpose": {
      "type": "string",
      "maxLength": 256
    },
    "consent_version": {
      "type": "string",
      "maxLength": 64
    },
    "policy_version": {
      "type": "string",
      "maxLength": 64
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2})?$",
      "maxLength": 10
    },
    "preferred_address": {
      "description": "Optional trusted elder-profile address supplied by Core. Runtime must not infer a title when absent.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 80,
      "default": null
    },
    "response_length": {
      "description": "Trusted elder-profile response-length preference supplied by Core.",
      "type": "string",
      "enum": ["SHORT", "STANDARD", "DETAILED"],
      "default": "STANDARD"
    },
    "input_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confirmed_memories": {
      "description": "Core-authorized current ACTIVE memory versions. Candidates, inactive/deleted memories, and superseded versions are forbidden.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "version", "memory_type", "content", "consent_version"],
        "properties": {
          "memory_id": { "type": "string", "format": "uuid" },
          "version": { "type": "integer", "minimum": 1 },
          "memory_type": {
            "type": "string",
            "enum": [
              "PREFERENCE",
              "IMPORTANT_RELATIONSHIP",
              "ROUTINE",
              "COMMUNICATION_PREFERENCE",
              "PERSONAL_HISTORY"
            ]
          },
          "content": { "type": "string", "minLength": 1, "maxLength": 500 },
          "consent_version": { "type": "integer", "minimum": 1 }
        }
      },
      "default": []
    },
    "verified_care_events": {
      "description": "Core-authorized current VERIFIED/CORRECTED event summaries selected through projection references and rechecked against formal state.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "version", "event_type", "summary_text", "consent_version"],
        "properties": {
          "event_id": { "type": "string", "format": "uuid" },
          "version": { "type": "integer", "minimum": 1 },
          "event_type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "summary_text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "consent_version": { "type": "integer", "minimum": 1 }
        }
      },
      "default": []
    },
    "allowed_tools": {
      "description": "Legacy per-run Tool allowlist retained for wire compatibility. The canonical Core companion path sends an empty list; Runtime does not use this field to write Core domain state.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,40}$"
      },
      "default": []
    },
    "requested_outputs": {
      "description": "Optional Core-derived proposal outputs. This is not an authorization grant and never permits Runtime to write domain state.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["event_candidate", "memory_candidate"]
      },
      "maxItems": 2,
      "uniqueItems": true,
      "default": []
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "latency_budget_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["confirmed_memories"],
        "properties": {
          "confirmed_memories": { "minItems": 1 }
        }
      },
      "then": {
        "properties": {
          "purpose": { "const": "BASIC_VOICE" }
        }
      }
    }
    ,
    {
      "if": {
        "required": ["verified_care_events"],
        "properties": {
          "verified_care_events": { "minItems": 1 }
        }
      },
      "then": {
        "properties": {
          "purpose": { "const": "BASIC_VOICE" }
        }
      }
    }
  ]
}
