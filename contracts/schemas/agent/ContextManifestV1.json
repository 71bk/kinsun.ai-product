{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/agent/ContextManifestV1.json",
  "title": "ContextManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_manifest_id",
    "agent_id",
    "elder_id",
    "tenant_id",
    "purpose",
    "consent_version",
    "policy_version",
    "items",
    "excluded_items",
    "total_token_estimate",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context_manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "elder_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "purpose": {
      "type": "string",
      "maxLength": 256
    },
    "consent_version": {
      "type": "string",
      "maxLength": 64
    },
    "policy_version": {
      "type": "string",
      "maxLength": 64
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "source_type", "content", "token_estimate"],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "source_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "content": {
            "type": "string",
            "maxLength": 2048
          },
          "token_estimate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "excluded_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "reason_code"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "reason_code": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "total_token_estimate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
