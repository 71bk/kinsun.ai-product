  "required": [
    "elder_id",
    "actor_id",
    "enrollment_id",
    "relationship_id",
    "display_name",
    "preferred_name",
    "preferred_language",
    "primary_care_setting",
    "care_unit_id",
    "care_profile"
  ],
  "title": "AccountlessElderV1",
  "type": "object",
