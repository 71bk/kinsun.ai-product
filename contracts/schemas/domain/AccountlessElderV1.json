    "care_unit_id": {
      "format": "uuid",
      "title": "Care Unit Id",
      "type": "string"
    },
    "care_profile": {
      "items": {
        "$ref": "#/$defs/CareProfileEntryResponse"
      },
      "title": "Care Profile",
      "type": "array"
    }
