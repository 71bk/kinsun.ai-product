{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/LinkLineIdentityRequestV1.json",
  "title": "LinkLineIdentityRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id_token", "expected_nonce"],
  "properties": {
    "id_token": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[^\\s]+$" },
    "expected_nonce": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
