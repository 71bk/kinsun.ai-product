{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/PasswordLoginRequestV1.json",
  "title": "PasswordLoginRequestV1",
  "description": "Private BFF-to-Core Kinsun Email and password verification request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "password"],
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254
    },
    "password": {
      "type": "string",
      "format": "password",
      "writeOnly": true,
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    }
  }
}
