{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/StartKinsunEmailAuthRequestV1.json",
  "title": "StartKinsunEmailAuthRequestV1",
  "description": "Private BFF request to create a uniform Kinsun registration challenge without disclosing account existence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "intent"],
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
    },
    "intent": {
      "type": "string",
      "enum": ["ELDER", "FAMILY", "STAFF"]
    },
    "display_name": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 120 }
      ]
    }
  }
}
