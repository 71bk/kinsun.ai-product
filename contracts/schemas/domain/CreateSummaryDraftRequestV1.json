{
  "$defs": {
    "SummaryItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "MEAL",
            "ACTIVITY",
            "SLEEP",
            "MEDICATION_STATEMENT",
            "SOCIAL",
            "IMPORTANT_EVENT"
          ],
          "title": "Category",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Event Ids",
          "type": "array"
        },
        "data_status": {
          "enum": [
            "PRESENT",
            "NOT_MENTIONED",
            "INSUFFICIENT"
          ],
          "title": "Data Status",
          "type": "string"
        }
      },
      "required": [
        "category",
        "text",
        "source_event_ids",
        "data_status"
      ],
      "title": "SummaryItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary_date": {
      "format": "date",
      "title": "Summary Date",
      "type": "string"
    },
    "summary_type": {
      "const": "PROFESSIONAL_DAILY",
      "default": "PROFESSIONAL_DAILY",
      "title": "Summary Type",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SummaryItem"
      },
      "maxItems": 32,
      "title": "Items",
      "type": "array"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Missing Fields",
      "type": "array"
    },
    "conflict_flags": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Conflict Flags",
      "type": "array"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    }
  },
  "required": [
    "summary_date"
  ],
  "title": "CreateSummaryDraftRequestV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/CreateSummaryDraftRequestV1.json",
  "anyOf": [
    {
      "properties": {
        "items": {
          "minItems": 1
        }
      },
      "required": [
        "items"
      ]
    },
    {
      "properties": {
        "missing_fields": {
          "minItems": 1
        }
      },
      "required": [
        "missing_fields"
      ]
    }
  ]
}
