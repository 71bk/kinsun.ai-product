{
  "additionalProperties": false,
  "description": "Terminal outcome accepted by the compare-and-set completion command.",
  "properties": {
    "result_status": {
      "enum": [
        "SUCCESS",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "HUMAN_REVIEW",
        "NO_DATA",
        "SCHEMA_FAILED",
        "DEPENDENCY_FAILED",
        "TIME_BUDGET_EXCEEDED",
        "COST_BUDGET_EXCEEDED",
        "CANCELLED"
      ],
      "title": "Result Status",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    }
  },
  "required": [
    "result_status"
  ],
  "title": "CompleteAgentRunRequestV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/CompleteAgentRunRequestV1.json"
}
