{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/LineIdentityLinkResultV1.json",
  "title": "LineIdentityLinkResultV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "enum": ["LINKED", "ALREADY_LINKED"] } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "merge_token", "expires_at"],
      "properties": {
        "status": { "const": "MERGE_REQUIRED" },
        "merge_token": { "type": "string", "pattern": "^km1_[A-Za-z0-9_-]{43}$" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "MANUAL_REVIEW_REQUIRED" } }
    }
  ]
}
