      "format": "uuid",
      "title": "Agent Run Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "elder_id": {
      "format": "uuid",
      "title": "Elder Id",
      "type": "string"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "result_status": {
      "enum": [
        "SUCCESS",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "HUMAN_REVIEW",
        "NO_DATA",
        "SCHEMA_FAILED",
        "DEPENDENCY_FAILED",
        "TIME_BUDGET_EXCEEDED",
        "COST_BUDGET_EXCEEDED",
        "CANCELLED"
