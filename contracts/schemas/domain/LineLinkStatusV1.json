{
  "$id": "urn:kinsun:contracts:schemas:domain:LineLinkStatusV1",
  "title": "LineLinkStatusV1",
  "description": "Authenticated LINE link status without LINE user ID, keyed digest, linkToken, nonce or webhook identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "linked", "status", "linked_at", "can_unlink"],
  "properties": {
    "provider": { "type": "string", "const": "LINE" },
    "linked": { "type": "boolean" },
    "status": { "type": "string", "enum": ["ACTIVE", "UNLINKED"] },
    "linked_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "can_unlink": { "type": "boolean" }
  },
  "oneOf": [
    {
      "properties": {
        "linked": { "const": true },
        "status": { "const": "ACTIVE" },
        "linked_at": { "type": "string", "format": "date-time" },
        "can_unlink": { "const": true }
      }
    },
    {
      "properties": {
        "linked": { "const": false },
        "status": { "const": "UNLINKED" },
        "linked_at": { "type": "null" },
        "can_unlink": { "const": false }
      }
    }
  ]
}
