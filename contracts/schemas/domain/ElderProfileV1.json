      "type": "string"
    },
    "elder_id": {
      "format": "uuid",
      "title": "Elder Id",
      "type": "string"
    },
    "profile_version": {
      "minimum": 1,
      "title": "Profile Version",
      "type": "integer"
    }
  },
  "required": [
    "display_name",
    "preferred_name",
    "preferred_language",
    "elder_id",
    "profile_version"
