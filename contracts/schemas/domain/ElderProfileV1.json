{
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "preferred_name": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Preferred Name"
    },
    "preferred_language": {
      "enum": [
        "ZH_TW",
        "NAN_TW",
        "HAK_TW",
        "EN_US",
        "MIXED",
