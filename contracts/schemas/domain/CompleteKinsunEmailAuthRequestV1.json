{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/CompleteKinsunEmailAuthRequestV1.json",
  "title": "CompleteKinsunEmailAuthRequestV1",
  "description": "Private BFF request that consumes one Kinsun registration challenge and establishes a password.",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_token", "verification_code", "password"],
  "properties": {
    "challenge_token": {
      "type": "string",
      "pattern": "^ke1_[A-Za-z0-9_-]{43}$"
    },
    "verification_code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^[^\\u0000]{12,128}$",
      "writeOnly": true
    },
    "invitation_code": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 16, "maxLength": 24 }
      ]
    }
  }
}
