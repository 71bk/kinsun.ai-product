{
  "$defs": {
    "CareEventType": {
      "enum": [
        "MEAL",
        "ACTIVITY",
        "SLEEP",
        "MEDICATION_STATEMENT",
        "EMOTION_EXPRESSION",
        "SOCIAL_CONTACT",
        "EXPECTED_CONTACT_MISSED",
        "ACTIVITY_PARTICIPATION",
        "ACTIVITY_CANCELLED",
        "COMPANIONSHIP_NEED"
      ],
      "title": "CareEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "VERIFY",
        "CORRECT",
        "REJECT",
        "EXCLUDE"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "corrected_payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "audio",
                "audio_uri",
                "transcript",
                "transcript_text",
                "prompt",
                "full_prompt",
                "secret",
                "token",
                "asr_confidence"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected Payload"
    },
    "corrected_event_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/CareEventType"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CORRECT only. Omit to preserve the type; null is rejected."
    },
    "corrected_event_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CORRECT only. Omit to preserve; null clears time; otherwise include timezone.",
      "title": "Corrected Event Time"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    }
  },
  "required": [
    "decision",
    "reason_code",
    "expected_version"
  ],
  "title": "ReviewCareEventRequestV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/ReviewCareEventRequestV1.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "CORRECT"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "corrected_payload"
        ],
        "properties": {
          "corrected_payload": {
            "type": "object"
          },
          "corrected_event_type": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "VERIFY",
              "REJECT",
              "EXCLUDE"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "corrected_payload": {
            "type": "null"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "corrected_event_type"
              ]
            },
            {
              "required": [
                "corrected_event_time"
              ]
            }
          ]
        }
      }
    }
  ]
}
