{
  "$defs": {
    "MemoryKind": {
      "enum": [
        "MUSIC_PREFERENCE",
        "HOBBY",
        "PREFERRED_ADDRESS",
        "FAMILY_RELATIONSHIP",
        "CONTACT_ROUTINE",
        "DAILY_ROUTINE",
        "HEALTH_INFERENCE",
        "MEDICATION_JUDGMENT",
        "MOOD_OR_LONELINESS_INFERENCE",
        "FAMILY_CONFLICT",
        "FINANCIAL_INFORMATION",
        "SENSITIVE_OR_UNKNOWN"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryRiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "MemoryRiskLevel",
      "type": "string"
    },
    "MemoryType": {
      "enum": [
        "PREFERENCE",
        "IMPORTANT_RELATIONSHIP",
        "ROUTINE",
        "COMMUNICATION_PREFERENCE",
        "PERSONAL_HISTORY"
      ],
      "title": "MemoryType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "memory_type": {
      "$ref": "#/$defs/MemoryType"
    },
    "memory_kind": {
      "$ref": "#/$defs/MemoryKind"
    },
    "normalized_content": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Normalized Content",
      "type": "string"
    },
    "source_event_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Source Event Ids",
      "type": "array"
    },
    "possible_conflict": {
      "default": false,
      "title": "Possible Conflict",
      "type": "boolean"
    },
    "conflict_with_memory_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Conflict With Memory Ids",
      "type": "array"
    },
    "confirmation_question": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Confirmation Question",
      "type": "string"
    },
    "extractor_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Extractor Version",
      "type": "string"
    },
    "extraction_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Extraction Confidence",
      "type": "number"
    },
    "proposal_risk_hint": {
      "$ref": "#/$defs/MemoryRiskLevel"
    }
  },
  "required": [
    "memory_type",
    "memory_kind",
    "normalized_content",
    "source_event_ids",
    "confirmation_question",
    "extractor_version",
    "extraction_confidence",
    "proposal_risk_hint"
  ],
  "title": "CreateMemoryCandidateRequestV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/CreateMemoryCandidateRequestV1.json"
}
