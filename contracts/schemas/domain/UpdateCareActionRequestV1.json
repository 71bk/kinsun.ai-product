{
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "IN_PROGRESS",
        "COMPLETED",
        "POSTPONED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "resolution": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    }
  },
  "required": [
    "status",
    "expected_version"
  ],
  "title": "UpdateCareActionRequestV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinsun.ai/contracts/schemas/domain/UpdateCareActionRequestV1.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "COMPLETED",
              "POSTPONED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolution"
        ],
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "POSTPONED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "due_at"
        ],
        "properties": {
          "due_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
