            "assignment_id",
            "version",
            "status"
          ],
          "properties": {
            "service_record_id": {
              "type": "string",
              "format": "uuid"
            },
            "assignment_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "const": 1
            },
            "status": {
